+def build(cfg, pretrained_models=None):
+    """O nucleo reutilizavel da construcao.
+
+    Recebe um `cfg` ja' pronto (sem ler sys.argv) e, opcionalmente, um dicionario
+    de modelos JA' CARREGADOS. E' este o ponto de entrada para um servico que
+    mantem os modelos residentes: carregue uma vez no startup e passe aqui a
+    cada requisicao.
 
+    Quando `pretrained_models` e' None, carrega do jeito tradicional -- o que
+    preserva exatamente o comportamento do CLI.
+    """
